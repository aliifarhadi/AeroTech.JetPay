{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "IdGenerator": {
    "GeneratorId": 0
  },
  "PaymentSessions": {
    "LockExpirySeconds": 30
  },
  "PaymentExpiry": {
    "IntervalSeconds": 60,
    "MaxBatch": 100
  },
  "PaymentAcceptancePolicy": {
    "AllowPgwForStaffAssisted": false
  },
  "MockJetPay": {
    "Enabled": false
  },
  "AllowedHosts": "*"
}
