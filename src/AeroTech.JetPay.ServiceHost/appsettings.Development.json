{
  "ConnectionStrings": {
    "CommandDbContext": "Server=localhost\\SQLEXPRESS;Database=DotAirAeroTechJetPay;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True;Pooling=true",
    "QueryDbContext": "Server=localhost\\SQLEXPRESS;Database=DotAirAeroTechJetPay;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True;Pooling=true"
  },
  "Redis": {
    "Host": "localhost",
    "Prefix": "DotAir"
  },
  "RabbitMq": {
    "Server": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest"
  },
  "EventSubscriber": {
    "SubscriptionName": "JetPayEventPublisher",
    "EventTable": "DomainEvents",
    "CursorTable": "EventSubscriptionCursors",
    "PullingInterval": 100
  },
  "Inbox": {
    "TableName": "InboxMessages"
  },
  "Outbox": {
    "TableName": "OutboxMessages",
    "PublishIntervalSeconds": 30,
    "BatchSize": 50
  },
  "PaymentIntents": {
    "LockExpirySeconds": 30
  },
  "PaymentIntentExpiry": {
    "IntervalSeconds": 60,
    "MaxBatch": 100
  },
  "MockJetPay": {
    "Enabled": true,
    "PublicBaseUrl": "http://localhost:4747",
    "CustomerActionTtlSeconds": 900,
    "ExpiringCustomerActionTtlSeconds": 300,
    "ExpiringAuthorizationValiditySeconds": 300,
    "Bnpl": {
      "SupportsIssuanceGuaranteeOnAuthorization": true,
      "AuthorizationValiditySeconds": 86400
    },
    "AgencyCredit": {
      "SupportsIssuanceGuaranteeOnAuthorization": true,
      "AuthorizationValiditySeconds": null
    }
  },
  "Fluentd": {
    "Uri": "192.168.55.160",
    "Tag": "dotair.jetpay",
    "Port": "80",
    "ServiceName": "AeroTech.JetPay"
  },
  "AirInfo": {
    "BaseUrl": "https://aerotech-airinfo.dotair.stg.agidp.ir/service/",
    "RequestTimeout": 2,
    "RetryCount": 3,
    "RetryInterval": 300
  },
  "ReferenceData": {
    "PrimaryLanguage": "en"
  },
  "AeroCore": {
    "BaseUrl": "https://aerotech-core.dotair.stg.agidp.ir/service/",
    "RequestTimeout": 2,
    "RetryCount": 3,
    "RetryInterval": 300
  },
   "FlightFlow": {
    "BaseUrl": "https://aerotech-flightflow.dotair.stg.agidp.ir/service/",
    "RequestTimeout": 2,
    "RetryCount": 3,
    "RetryInterval": 300
  },
   "Offer": {
    "BaseUrl": "https://aerotech-airavail.dotair.stg.agidp.ir/service/",
    "RequestTimeout": 2,
    "RetryCount": 3,
    "RetryInterval": 300
  },
   "Pricing": {
    "BaseUrl": "https://aerotech-airprice.dotair.stg.agidp.ir/service/",
    "RequestTimeout": 2,
    "RetryCount": 3,
    "RetryInterval": 300
  },
   "Identity": {
    "BaseUrl": "https://aerotech-identityservice.dotair.stg.agidp.ir/service/",
    "RequestTimeout": 2,
    "RetryCount": 3,
    "RetryInterval": 300
   },
   "Ordering": {
    "BaseUrl": "http://localhost:4044/service/",
    "RequestTimeout": 2,
    "RetryCount": 3,
    "RetryInterval": 300
  },
   "StoredValue": {
    "BaseUrl": "http://localhost:5057/service/",
    "RequestTimeout": 2,
    "RetryCount": 3,
    "RetryInterval": 300
  },
   "LedgerFlow": {
    "BaseUrl": "http://localhost:5056/service/",
    "RequestTimeout": 2,
    "RetryCount": 3,
    "RetryInterval": 300
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information"
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Code, Serilog.Sinks.Console",
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} <s:{SourceContext}>{NewLine}{Exception}"
        }
      }
    ]
  },
  "UseDeveloperExceptionPage": true,  
  "BackgroundServices": {
    "OutboxPriodInSeconds": 30
  }
}
